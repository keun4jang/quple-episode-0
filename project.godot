; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="쿼플"
config/description="쿼카 커플의 힐링 여행"
run/main_scene="res://scenes/menu/MainMenu3D.tscn"
config/features=PackedStringArray("4.3")
config/icon="res://assets/icon/icon-512.png"
config/version="0.1.28"

[autoload]

AutoUpdate="*res://scripts/systems/auto_update.gd"
Episode0State="*res://scripts/systems/episode0_state.gd"
TravelState="*res://scripts/systems/travel_state.gd"
SaveManager="*res://scripts/systems/save_manager.gd"
AudioManager="*res://scripts/systems/audio_manager.gd"
SceneTransition="*res://scenes/systems/SceneTransition.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=4
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom="res://assets/themes/quple_bold.tres"

input_devices/pointing/emulate_touch_from_mouse=false

